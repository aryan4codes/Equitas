# Environment configuration for Equitas

# OpenAI API Key (optional; LLM remediation and advanced bias tests)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Database (SQLite / Postgres SQLAlchemy URL)
DATABASE_URL=sqlite+aiosqlite:///./equitas.db

# MongoDB (required for credits, logging, dashboard metrics)
MONGODB_URL=mongodb+srv://user:pass@cluster.mongodb.net/equitas
MONGODB_DATABASE=equitas

# Security
SECRET_KEY=your-secret-key-change-in-production-use-strong-random-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Clerk (dashboard: users, API keys, credit requests)
CLERK_SECRET_KEY=sk_test_your_clerk_secret
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,https://your-frontend.vercel.app

# Application environment: development | production
ENVIRONMENT=development

# Low-memory deploy (Render 512MB): set true to skip PyTorch/Detoxify/transformers at startup
EQUITAS_SLIM=false

# Guardian / model defaults
DEFAULT_TOXICITY_THRESHOLD=0.7
DEFAULT_BIAS_THRESHOLD=0.3
ENABLE_ASYNC_LOGGING=true

# Model Settings
TOXICITY_MODEL=openai-moderation
BIAS_DETECTION_ENABLED=true
JAILBREAK_DETECTION_ENABLED=true
